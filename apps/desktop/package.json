{
  "name": "@accomplish/desktop",
  "version": "0.4.5",
  "packageManager": "pnpm@9.15.0",
  "private": true,
  "type": "module",
  "description": "Open Deskmate Desktop App",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "postinstall": "node scripts/postinstall.cjs",
    "dev": "node scripts/patch-electron-name.cjs && rimraf dist-electron && vite",
    "dev:clean": "CLEAN_START=1 vite",
    "build": "pnpm download:nodejs && tsc && vite build && npm --prefix skills/dev-browser install --omit=dev && npm --prefix skills/file-permission install --omit=dev && npm --prefix skills/canvas install --omit=dev && npm --prefix skills/node-tools install --omit=dev && npm --prefix skills/build-runtime-tools install --omit=dev && npm --prefix skills/tool-discovery install --omit=dev && rimraf skills/memory-tools/node_modules && node scripts/run-bundled-npm.cjs --prefix skills/memory-tools install --omit=dev && node scripts/run-bundled-node.cjs skills/memory-tools/scripts/verify-fts5.cjs",
    "build:win": "pnpm download:nodejs && tsc && vite build && npm --prefix skills/dev-browser install --omit=dev && npm --prefix skills/file-permission install --omit=dev && npm --prefix skills/canvas install --omit=dev && npm --prefix skills/node-tools install --omit=dev && npm --prefix skills/build-runtime-tools install --omit=dev && npm --prefix skills/tool-discovery install --omit=dev && rimraf skills/memory-tools/node_modules && node scripts/run-bundled-npm.cjs --prefix skills/memory-tools install --omit=dev && node scripts/run-bundled-node.cjs skills/memory-tools/scripts/verify-fts5.cjs && node scripts/package.cjs --win --publish never",
    "build:win:portable": "pnpm download:nodejs && tsc && vite build && npm --prefix skills/dev-browser install --omit=dev && npm --prefix skills/file-permission install --omit=dev && npm --prefix skills/canvas install --omit=dev && npm --prefix skills/node-tools install --omit=dev && npm --prefix skills/build-runtime-tools install --omit=dev && npm --prefix skills/tool-discovery install --omit=dev && rimraf skills/memory-tools/node_modules && node scripts/run-bundled-npm.cjs --prefix skills/memory-tools install --omit=dev && node scripts/run-bundled-node.cjs skills/memory-tools/scripts/verify-fts5.cjs && node scripts/package.cjs --win portable --publish never",
    "build:electron": "pnpm download:nodejs && tsc && vite build && npm --prefix skills/dev-browser install --omit=dev && npm --prefix skills/file-permission install --omit=dev && npm --prefix skills/canvas install --omit=dev && npm --prefix skills/node-tools install --omit=dev && npm --prefix skills/build-runtime-tools install --omit=dev && npm --prefix skills/tool-discovery install --omit=dev && rimraf skills/memory-tools/node_modules && node scripts/run-bundled-npm.cjs --prefix skills/memory-tools install --omit=dev && node scripts/run-bundled-node.cjs skills/memory-tools/scripts/verify-fts5.cjs && node scripts/package.cjs",
    "build:unpack": "pnpm download:nodejs && tsc && vite build && npm --prefix skills/dev-browser install --omit=dev && npm --prefix skills/file-permission install --omit=dev && npm --prefix skills/canvas install --omit=dev && npm --prefix skills/node-tools install --omit=dev && npm --prefix skills/build-runtime-tools install --omit=dev && npm --prefix skills/tool-discovery install --omit=dev && rimraf skills/memory-tools/node_modules && node scripts/run-bundled-npm.cjs --prefix skills/memory-tools install --omit=dev && node scripts/run-bundled-node.cjs skills/memory-tools/scripts/verify-fts5.cjs && node scripts/package.cjs --dir",
    "opencode:smoke": "node scripts/opencode-smoke.cjs",
    "package": "pnpm build && node scripts/package.cjs --mac --publish never",
    "package:mac": "pnpm build && node scripts/package.cjs --mac --publish never",
    "release": "pnpm build && node scripts/package.cjs --mac --publish always",
    "release:mac": "pnpm build && node scripts/package.cjs --mac --publish always",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist dist-electron release",
    "download:nodejs": "node scripts/download-nodejs.cjs",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config=e2e/playwright.config.ts --debug",
    "test:e2e:fast": "playwright test --config=e2e/playwright.config.ts --project=electron-fast",
    "test:e2e:integration": "playwright test --config=e2e/playwright.config.ts --project=electron-integration",
    "test:e2e:report": "playwright show-report e2e/html-report"
  },
  "dependencies": {
    "@accomplish/shared": "workspace:*",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.16",
    "@picovoice/porcupine-node": "^3.0.6",
    "@picovoice/pvrecorder-node": "^1.2.8",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@uiw/react-codemirror": "^4.25.7",
    "@xterm/addon-fit": "^0.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "croner": "^8.0.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "electron-store": "^8.2.0",
    "framer-motion": "^12.26.2",
    "grammy": "^1.22.4",
    "keytar": "^7.9.0",
    "lamejs": "^1.2.1",
    "lucide-react": "^0.454.0",
    "mammoth": "^1.11.0",
    "node-pty": "^1.1.0",
    "opencode-ai": "1.15.11",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.15.1",
    "react-syntax-highlighter": "^15.6.1",
    "react-virtuoso": "^4.18.3",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.21.0",
    "xterm": "^5.3.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.20",
    "electron": "^39.8.5",
    "electron-builder": "^25.1.8",
    "electron-builder-squirrel-windows": "25.1.8",
    "happy-dom": "^20.8.9",
    "jsdom": "^27.4.0",
    "png-to-ico": "^2.1.1",
    "postcss": "^8.5.10",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.28.8",
    "vitest": "^4.1.0"
  },
  "build": {
    "appId": "ai.accomplish.desktop",
    "productName": "OpenDeskmate",
    "extraMetadata": {
      "name": "opendeskmate"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "compression": "normal",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist-electron",
        "to": "dist-electron",
        "filter": [
          "**/*"
        ]
      },
      "package.json",
      "node_modules/opencode-ai/**",
      "node_modules/node-pty/**",
      "node_modules/electron-store/**",
      "node_modules/keytar/**",
      "node_modules/conf/**",
      "node_modules/env-paths/**",
      "node_modules/json-schema-typed/**",
      "node_modules/atomically/**",
      "node_modules/debounce-fn/**",
      "node_modules/discord.js/**",
      "node_modules/@discordjs/**",
      "node_modules/@sapphire/**",
      "node_modules/discord-api-types/**",
      "node_modules/@picovoice/**",
      "node_modules/grammy/**",
      "node_modules/fast-deep-equal/**",
      "node_modules/lodash.snakecase/**",
      "node_modules/magic-bytes.js/**",
      "node_modules/tslib/**",
      "node_modules/undici/**",
      "node_modules/ws/**",
      "!node_modules/@accomplish/**",
      "!node_modules/opencode-darwin-*/**",
      "!node_modules/opencode-linux-*/**",
      "!node_modules/opencode-win32-*/**",
      "!node_modules/opencode-windows-x64-baseline/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/opencode-ai/bin/opencode",
      "node_modules/opencode-ai/bin/opencode.exe",
      "node_modules/opencode-ai/package.json",
      "node_modules/opencode-windows-x64/bin/opencode.exe",
      "node_modules/node-pty/build/**/*.node",
      "node_modules/node-pty/package.json",
      "node_modules/keytar/build/**/*.node",
      "node_modules/keytar/package.json",
      "node_modules/@picovoice/porcupine-node/**/*",
      "node_modules/@picovoice/pvrecorder-node/**/*",
      "dist-electron/main/mcp/*.js"
    ],
    "afterPack": "./scripts/after-pack.cjs",
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/help-defaults",
        "to": "help-defaults"
      },
      {
        "from": "src/main/canvas-host/a2ui",
        "to": "canvas-host/a2ui"
      },
      {
        "from": "skills",
        "to": "skills",
        "filter": [
          "**/*",
          "!**/profiles/**",
          "!**/tmp/**",
          "!**/.git/**",
          "!**/.browser-data/**",
          "!**/node_modules/accomplish",
          "!**/node_modules/accomplish/**",
          "!**/node_modules/opendeskmate",
          "!**/node_modules/opendeskmate/**",
          "!**/node_modules/@accomplish",
          "!**/node_modules/@accomplish/**",
          "!**/node_modules/@accomplish/desktop",
          "!**/node_modules/@accomplish/desktop/**",
          "!**/bun.lock",
          "!**/*.test.ts",
          "!**/vitest.config.ts"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "accomplish-ai",
      "repo": "openwork"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "icon": "resources/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "OpenDeskmate-${version}-win-x64-installer.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "OpenDeskmate-${version}-win-x64-portable.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
